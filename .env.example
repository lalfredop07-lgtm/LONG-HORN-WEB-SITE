# ====================================================================
# LongHorn Perú — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local ni .env.production al repositorio.
# ====================================================================

# URL pública del sitio. Se usa para canonicals, sitemap, robots y Open Graph.
# Producción: https://longhornperu.com  ·  Preview: la URL que asigne Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------
# Google Maps Platform (mapa de la página /locales)
# Clave de navegador, RESTRINGIDA por referente HTTP y por API
# (solo "Maps JavaScript API"). Sin esta clave el sitio sigue funcionando:
# el directorio de locales se muestra completo y el mapa se sustituye por
# un aviso con enlaces a Google Maps.
# --------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID de la nube para estilos y marcadores avanzados.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --------------------------------------------------------------------
# Google Analytics 4 — opcional.
# Si se deja vacío no se carga ningún script de analítica.
# --------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --------------------------------------------------------------------
# Verificación de propiedad en Google Search Console (meta tag).
# --------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --------------------------------------------------------------------
# Indexación. En producción debe ser "true"; en previews, "false",
# para que Google no indexe entornos de pruebas.
# --------------------------------------------------------------------
NEXT_PUBLIC_INDEXABLE=false
